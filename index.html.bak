<script>
  // Featured grid on home — 2 interior highlights
  document.addEventListener("DOMContentLoaded", () => {
    const wrap = document.querySelector("[data-featured]");
    if(!wrap) return;
    const featured = getProjectsByDiscipline("interior").slice(0,2);
    wrap.innerHTML = featured.map(projectCardHTML).join("");
    initReveal();
  });
</script>
